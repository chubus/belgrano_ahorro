# =================================================================
# CONFIGURACIÓN DE ENTORNO - SINCRONIZACIÓN BIDIRECCIONAL
# BELGRANO AHORRO ↔ BELGRANO TICKETERA
# =================================================================

# Configuración de la API de Belgrano Ahorro
BELGRANO_AHORRO_URL=https://belgranoahorro-hp30.onrender.com
BELGRANO_AHORRO_API_KEY=belgrano_ahorro_api_key_2025

# Configuración de la Ticketera
TICKETERA_URL=https://ticketerabelgrano.onrender.com
TICKETERA_API_KEY=ticketera_api_key_2025

# Configuración de sincronización
SYNC_INTERVAL_PRODUCTOS=300
SYNC_INTERVAL_TICKETS=60
SYNC_INTERVAL_ESTADOS=120

# Timeouts y reintentos de API
API_TIMEOUT=15
MAX_RETRIES=5
RETRY_DELAY=2

# Entorno de producción
RENDER_ENVIRONMENT=production

# Configuración de DevOps
DEVOPS_USERNAME=devops
DEVOPS_PASSWORD=devops2025

# Configuración de la aplicación
FLASK_ENV=production
SECRET_KEY=belgrano_ahorro_secret_key_2025

# Configuración de Docker
DOCKER_BUILDKIT=0
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Logging y monitoreo
LOG_LEVEL=INFO
HEALTH_CHECK_INTERVAL=30
ENABLE_METRICS=true
