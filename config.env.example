# =================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - BELGRANO AHORRO
# =================================================================

# Configuración de la aplicación
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=admin123

# Configuración de base de datos
DATABASE_PATH=belgrano_ahorro.db

# =================================================================
# CONFIGURACIÓN DE API - BELGRANO AHORRO
# =================================================================

# URL de la aplicación principal de Belgrano Ahorro
BELGRANO_AHORRO_URL=http://localhost:5000

# Clave de API para comunicación entre servicios
BELGRANO_AHORRO_API_KEY=belgrano_ahorro_api_key_2025

# =================================================================
# CONFIGURACIÓN DE TICKETERA
# =================================================================

# URL de la ticketera
TICKETERA_URL=http://localhost:5001

# Clave de API para comunicación con ticketera
TICKETERA_API_KEY=belgrano_tickets_api_key_2025

# =================================================================
# CONFIGURACIÓN DE DEVOPS
# =================================================================

# URL de DevOps (si es diferente)
DEVOPS_URL=http://localhost:5002

# Configuración de sincronización
SYNC_ENABLED=True
SYNC_TIMEOUT=10

# =================================================================
# CONFIGURACIÓN DE PRODUCCIÓN
# =================================================================

# Para producción, cambiar las URLs a las reales:
# BELGRANO_AHORRO_URL=https://belgranoahorro-hp30.onrender.com
# TICKETERA_URL=https://ticketerabelgrano.onrender.com
# DEVOPS_URL=https://devops-belgrano.onrender.com

# =================================================================
# CONFIGURACIÓN DE LOGGING
# =================================================================

LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =================================================================
# CONFIGURACIÓN DE SEGURIDAD
# =================================================================

# Configuración de sesiones
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5

# Configuración de CORS (si es necesario)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5001