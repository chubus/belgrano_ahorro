# =================================================================
# CONFIGURACIÓN DE ENTORNO - BELGRANO AHORRO TICKETERA
# =================================================================

# Configuración de la API de Belgrano Ahorro
BELGRANO_AHORRO_URL=https://belgranoahorro-hp30.onrender.com
BELGRANO_AHORRO_API_KEY=belgrano_ahorro_api_key_2025

# Configuración de la Ticketera
TICKETERA_URL=https://ticketerabelgrano.onrender.com
RENDER_ENVIRONMENT=production

# Configuración de DevOps
DEVOPS_USERNAME=devops
DEVOPS_PASSWORD=devops2025

# Configuración de la aplicación
FLASK_ENV=production
SECRET_KEY=belgrano_ahorro_secret_key_2025

# Configuración de Docker
DOCKER_BUILDKIT=0
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Timeouts de API
API_TIMEOUT_SECS=8
