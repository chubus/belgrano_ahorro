# =================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - SISTEMA DEVOPS
# =================================================================

# URL de Belgrano Ahorro (producción)
BELGRANO_AHORRO_URL=https://belgranoahorro-hp30.onrender.com

# API Key para autenticación con Belgrano Ahorro
BELGRANO_AHORRO_API_KEY=belgrano_ahorro_api_key_2025

# Configuración de sincronización
DEVOPS_SYNC_TIMEOUT=10
DEVOPS_SYNC_RETRY_ATTEMPTS=3
DEVOPS_SYNC_RETRY_DELAY=2
DEVOPS_RATE_LIMIT=100

# Configuración de logging
DEVOPS_LOG_LEVEL=INFO
DEVOPS_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Configuración de seguridad
DEVOPS_ALLOWED_ORIGINS=devops,admin,system

# Configuración de base de datos (si se usa)
DEVOPS_DB_PATH=devops_sync.db
DEVOPS_DB_BACKUP_ENABLED=true
DEVOPS_DB_BACKUP_INTERVAL=3600

# Configuración de monitoreo
DEVOPS_MONITORING_ENABLED=true
DEVOPS_METRICS_INTERVAL=60
DEVOPS_ALERT_EMAIL=devops@belgrano.com

# Configuración de notificaciones
DEVOPS_SLACK_WEBHOOK=
DEVOPS_TELEGRAM_BOT_TOKEN=
DEVOPS_EMAIL_SMTP_SERVER=
DEVOPS_EMAIL_SMTP_PORT=587
DEVOPS_EMAIL_USERNAME=
DEVOPS_EMAIL_PASSWORD=

# Configuración de desarrollo
DEVOPS_DEBUG_MODE=false
DEVOPS_TEST_MODE=false
DEVOPS_MOCK_SYNC=false

# Configuración de caché
DEVOPS_CACHE_ENABLED=true
DEVOPS_CACHE_TTL=300
DEVOPS_CACHE_MAX_SIZE=1000

# Configuración de rate limiting
DEVOPS_RATE_LIMIT_WINDOW=60
DEVOPS_RATE_LIMIT_MAX_REQUESTS=100

# Configuración de timeouts
DEVOPS_REQUEST_TIMEOUT=30
DEVOPS_CONNECTION_TIMEOUT=10
DEVOPS_READ_TIMEOUT=30

# Configuración de reintentos
DEVOPS_MAX_RETRIES=5
DEVOPS_RETRY_BACKOFF_FACTOR=2
DEVOPS_RETRY_STATUS_CODES=500,502,503,504

# Configuración de validación
DEVOPS_VALIDATE_INPUT=true
DEVOPS_VALIDATE_OUTPUT=true
DEVOPS_STRICT_MODE=false

# Configuración de auditoría
DEVOPS_AUDIT_LOG_ENABLED=true
DEVOPS_AUDIT_LOG_LEVEL=INFO
DEVOPS_AUDIT_LOG_RETENTION_DAYS=90

# Configuración de backup
DEVOPS_BACKUP_ENABLED=true
DEVOPS_BACKUP_INTERVAL_HOURS=24
DEVOPS_BACKUP_RETENTION_DAYS=30
DEVOPS_BACKUP_PATH=./backups

# Configuración de health checks
DEVOPS_HEALTH_CHECK_INTERVAL=30
DEVOPS_HEALTH_CHECK_TIMEOUT=10
DEVOPS_HEALTH_CHECK_RETRIES=3

# Configuración de métricas
DEVOPS_METRICS_ENABLED=true
DEVOPS_METRICS_PORT=9090
DEVOPS_METRICS_PATH=/metrics

# Configuración de alertas
DEVOPS_ALERTS_ENABLED=true
DEVOPS_ALERT_THRESHOLD_ERROR_RATE=0.1
DEVOPS_ALERT_THRESHOLD_RESPONSE_TIME=5000
DEVOPS_ALERT_COOLDOWN_MINUTES=15
