# Configuración de entorno para DevOps
# Copiar este archivo a .env y completar los valores

# Entorno de la aplicación (development, production, testing)
FLASK_ENV=production
FLASK_DEBUG=false

# Clave secreta para la aplicación (generar una nueva con: python -c 'import secrets; print(secrets.token_hex(24))')
SECRET_KEY=tu_clave_secreta_aqui

# Configuración de la API de Belgrano Ahorro
BELGRANO_AHORRO_URL=https://belgranoahorro-aliq.onrender.com
BELGRANO_AHORRO_API_KEY=tu_api_key_aqui

# Configuración de base de datos (PostgreSQL en producción)
# Formato: postgresql://usuario:contraseña@servidor:puerto/nombre_bd
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/belgrano_ahorro

# Configuración de correo (opcional)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=tu_correo@gmail.com
# MAIL_PASSWORD=tu_contraseña
# MAIL_DEFAULT_SENDER=tu_correo@gmail.com
