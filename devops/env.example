# ============================================================
# Variables de Entorno para DevOps
# ============================================================
# Copia este archivo a .env y completa con tus valores reales
# cp devops/env.example devops/.env

# ============================================================
# BELGRANO AHORRO API (OBLIGATORIO)
# ============================================================

# URL base de la API de Belgrano Ahorro
# Ejemplo producción: https://belgranoahorro-hp30.onrender.com
# Ejemplo desarrollo: http://localhost:5000
BELGRANO_AHORRO_URL=https://belgranoahorro-hp30.onrender.com

# API Key para autenticación con Belgrano Ahorro
# Obtener desde el panel de administración de Belgrano Ahorro
BELGRANO_AHORRO_API_KEY=tu_api_key_aqui

# ============================================================
# CONFIGURACIÓN DE API (OPCIONAL - valores por defecto)
# ============================================================

# Timeout en segundos para requests HTTP (default: 15)
API_TIMEOUT_SECS=15

# Número total de reintentos en caso de fallo (default: 3)
API_RETRY_TOTAL=3

# Factor de espera entre reintentos en segundos (default: 0.5)
API_RETRY_BACKOFF=0.5

# ============================================================
# BASE DE DATOS (OPCIONAL - solo si usas manager.py con SQLite)
# ============================================================

# Ruta a la base de datos SQLite de Belgrano Ahorro
# Si no se especifica, busca en: belgrano_ahorro.db, ../belgrano_ahorro.db, ./belgrano_ahorro.db
BELGRANO_AHORRO_DB_PATH=belgrano_ahorro.db

# ============================================================
# TICKETERA / DEVOPS API (OPCIONAL - si necesitas integración)
# ============================================================

# URL de la API de Ticketera/DevOps
# Solo necesario si DevOps necesita comunicarse con Ticketera
DEVOPS_API_URL=http://localhost:5002
# O usar alias:
# TICKETERA_URL=http://localhost:5002

# API Key para Ticketera (si aplica)
DEVOPS_API_KEY=tu_devops_api_key_aqui
# O usar alias:
# TICKETERA_API_KEY=tu_ticketera_api_key_aqui

# Credenciales Basic Auth para Ticketera (alternativa a API Key)
TICKETS_API_URL=http://localhost:5002
TICKETS_API_USERNAME=admin
TICKETS_API_PASSWORD=tu_password_aqui

# ============================================================
# SEGURIDAD DEVOPS (OPCIONAL - para login en panel DevOps)
# ============================================================

# Usuario para login en panel DevOps (default: devops)
DEVOPS_USERNAME=devops

# Contraseña para login en panel DevOps (default: devops_password)
# En producción, usar una contraseña segura
DEVOPS_PASSWORD=devops_password

# ============================================================
# NOTAS IMPORTANTES
# ============================================================
#
# 1. Variables OBLIGATORIAS para funcionamiento básico:
#    - BELGRANO_AHORRO_URL
#    - BELGRANO_AHORRO_API_KEY
#
# 2. Variables OPCIONALES tienen valores por defecto sensatos
#
# 3. Para producción, usar:
#    - Contraseñas seguras
#    - API Keys reales (no placeholders)
#    - URLs de producción (no localhost)
#
# 4. Cargar variables en Python:
#    from dotenv import load_dotenv
#    import os
#    load_dotenv('devops/.env')
#    url = os.getenv('BELGRANO_AHORRO_URL')
#
# ============================================================

