# Configuración completa para DevOps - Belgrano Ahorro
# Copie este archivo como .env y configure las variables

# =================================================================
# CONFIGURACIÓN DE API BELGRANO AHORRO
# =================================================================

# URL de la API de Belgrano Ahorro
BELGRANO_AHORRO_URL=http://localhost:5000

# Clave API para autenticación
BELGRANO_AHORRO_API_KEY=belgrano_ahorro_api_key_2025

# Timeout para requests (segundos)
API_TIMEOUT_SECS=30

# =================================================================
# CONFIGURACIÓN DE AUTENTICACIÓN JWT
# =================================================================

# Secreto para JWT (cambiar en producción)
JWT_SECRET=devops_jwt_secret_2025

# =================================================================
# CONFIGURACIÓN DE DEVOPS
# =================================================================

# Credenciales de DevOps
DEVOPS_USERNAME=devops
DEVOPS_PASSWORD=devops_2025

# =================================================================
# CONFIGURACIÓN DE BASE DE DATOS
# =================================================================

# Ruta de la base de datos
BELGRANO_AHORRO_DB_PATH=belgrano_ahorro.db

# =================================================================
# CONFIGURACIÓN DE LOGGING
# =================================================================

# Nivel de logging
LOG_LEVEL=INFO

# =================================================================
# CONFIGURACIÓN DE DESARROLLO
# =================================================================

# Modo de desarrollo
FLASK_ENV=development
DEBUG=True

# =================================================================
# CONFIGURACIÓN DE PRODUCCIÓN (Render)
# =================================================================

# Para producción en Render, use estas URLs:
# BELGRANO_AHORRO_URL=https://belgranoahorro-aliq.onrender.com
# BELGRANO_AHORRO_API_KEY=belgrano_ahorro_api_key_2025
