{
  "version": "1.0",
  "base_url": "https://belgranoahorro-hp30.onrender.com",
  "endpoints": {
    "autenticacion": {
      "POST /login": {
        "descripcion": "Iniciar sesión de usuario",
        "parametros": {
          "email": "string (requerido)",
          "password": "string (requerido)"
        },
        "respuesta": {
          "exito": "boolean",
          "usuario": "object",
          "mensaje": "string"
        }
      },
      "POST /register": {
        "descripcion": "Registrar nuevo usuario",
        "parametros": {
          "nombre": "string (requerido)",
          "apellido": "string (requerido)",
          "email": "string (requerido)",
          "password": "string (requerido)",
          "confirmar_password": "string (requerido)",
          "telefono": "string (opcional)",
          "direccion": "string (opcional)",
          "terminos": "boolean (requerido)"
        },
        "respuesta": {
          "exito": "boolean",
          "usuario_id": "integer",
          "mensaje": "string"
        }
      }
    },
    "productos": {
      "GET /api/v1/productos": {
        "descripcion": "Obtener lista de productos",
        "parametros": {
          "categoria": "string (opcional)",
          "destacados": "boolean (opcional)",
          "nuevos": "boolean (opcional)"
        },
        "respuesta": {
          "productos": "array",
          "total": "integer",
          "filtros": "object"
        }
      },
      "GET /api/v1/productos/{id}": {
        "descripcion": "Obtener producto específico",
        "parametros": {
          "id": "integer (requerido)"
        },
        "respuesta": {
          "producto": "object",
          "disponible": "boolean"
        }
      }
    },
    "pedidos": {
      "POST /api/v1/pedidos": {
        "descripcion": "Crear nuevo pedido",
        "parametros": {
          "productos": "array (requerido)",
          "direccion_entrega": "string (requerido)",
          "metodo_pago": "string (requerido)",
          "notas": "string (opcional)"
        },
        "respuesta": {
          "exito": "boolean",
          "pedido_id": "integer",
          "numero_pedido": "string"
        }
      },
      "GET /api/v1/pedidos/{id}": {
        "descripcion": "Obtener pedido específico",
        "parametros": {
          "id": "integer (requerido)"
        },
        "respuesta": {
          "pedido": "object",
          "items": "array",
          "estado": "string"
        }
      }
    },
    "comerciantes": {
      "POST /comerciantes/registro": {
        "descripcion": "Registrar nuevo comerciante",
        "parametros": {
          "nombre": "string (requerido)",
          "apellido": "string (requerido)",
          "email": "string (requerido)",
          "password": "string (requerido)",
          "nombre_negocio": "string (requerido)",
          "cuit": "string (opcional)",
          "tipo_negocio": "string (opcional)",
          "direccion_comercial": "string (opcional)",
          "telefono_comercial": "string (opcional)"
        },
        "respuesta": {
          "exito": "boolean",
          "comerciante_id": "integer",
          "mensaje": "string"
        }
      }
    }
  }
}