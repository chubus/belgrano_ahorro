# Configuración para DevOps - Gestión de Negocios
# Copie este archivo como .env y configure las variables

# URL de la API de Belgrano Ahorro
BELGRANO_AHORRO_URL=http://localhost:5000

# Clave API para autenticación
BELGRANO_AHORRO_API_KEY=your_api_key_here

# Timeout para requests (opcional, por defecto 10 segundos)
API_TIMEOUT_SECS=10

# Modo de desarrollo (opcional)
FLASK_ENV=development
