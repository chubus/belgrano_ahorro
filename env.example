# ============================================================
# BASE DE DATOS POSTGRESQL (OBLIGATORIO)
# ============================================================
# URL completa de PostgreSQL desde Render Dashboard
# Formato: postgresql://user:password@hostname:port/database?sslmode=require
# IMPORTANTE: El hostname debe ser completo (ej: dpg-xxx.frankfurt-postgres.render.com)
# NO usar solo "dpg-xxx" sin el dominio completo
# URL CORRECTA (usar SIEMPRE esta):
DATABASE_URL=postgresql://belgrano_ahorro_user:UeMrxst7VUVTBBQn3NtmorULotIKwCtr@dpg-d4b4rgi4d50c73d17hg0-a.frankfurt-postgres.render.com/belgrano_ahorro?sslmode=require

# Alternativa: POSTGRES_URL (si Render usa este nombre)
# POSTGRES_URL=postgresql://user:password@dpg-xxx.frankfurt-postgres.render.com:5432/database?sslmode=require

