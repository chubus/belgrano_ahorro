{% extends "devops/base.html" %}

{% block title %}Gestión de Productos - DevOps{% endblock %}
{% block page_title %}Gestión de Productos{% endblock %}

{% block content %}
<div class="row mb-4">
    <div class="col-md-6">
        <h4 class="mb-0">
            <i class="fas fa-box me-2"></i>Lista de Productos
        </h4>
        <p class="text-muted">Gestiona todos los productos del sistema</p>
    </div>
    <div class="col-md-6 text-end">
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#crearProductoModal">
            <i class="fas fa-plus me-2"></i>Crear Producto
        </button>
    </div>
</div>

<!-- Tabla de Productos -->
        <div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Precio</th>
                        <th>Categoría</th>
                        <th>Stock</th>
                        <th>Negocio</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for producto in productos %}
                    <tr>
                        <td>{{ producto.id }}</td>
                        <td>
                            <strong>{{ producto.nombre }}</strong>
                        </td>
                        <td>{{ producto.descripcion or '-' }}</td>
                        <td>
                            <span class="badge bg-success">${{ "%.2f"|format(producto.precio) }}</span>
                        </td>
                        <td>
                            <span class="badge bg-info">{{ producto.categoria or 'Sin categoría' }}</span>
                        </td>
                        <td>
                            {% if producto.stock > 0 %}
                                <span class="badge bg-success">{{ producto.stock }}</span>
                            {% else %}
                                <span class="badge bg-warning">Sin stock</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge bg-primary">{{ producto.negocio_nombre or 'Sin negocio' }}</span>
                        </td>
                        <td>
                            {% if producto.activo %}
                                <span class="badge bg-success">Activo</span>
                            {% else %}
                                <span class="badge bg-secondary">Inactivo</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <button class="btn btn-sm btn-warning" 
                                        onclick="editarProducto({{ producto.id }}, '{{ producto.nombre }}', '{{ producto.descripcion or '' }}', {{ producto.precio }}, '{{ producto.categoria or '' }}', {{ producto.stock }}, {{ producto.negocio_id or 'null' }}, {{ producto.activo|lower }})">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <form method="POST" action="{{ url_for('devops.eliminar_producto', producto_id=producto.id) }}" 
                                      style="display: inline;" onsubmit="return confirm('¿Estás seguro de eliminar este producto?')">
                                    <button type="submit" class="btn btn-sm btn-danger btn-delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                            </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="9" class="text-center text-muted">
                            <i class="fas fa-inbox me-2"></i>No hay productos registrados
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
        </div>
        
<!-- Modal Crear Producto -->
<div class="modal fade" id="crearProductoModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
    <script>
function editarProducto(id, nombre, descripcion, precio, categoria, stock, negocio_id, activo) {
    // Llenar el formulario de edición
    document.getElementById('edit_nombre').value = nombre;
    document.getElementById('edit_descripcion').value = descripcion;
    document.getElementById('edit_precio').value = precio;
    document.getElementById('edit_categoria').value = categoria;
    document.getElementById('edit_stock').value = stock;
    document.getElementById('edit_negocio_id').value = negocio_id || '';
    document.getElementById('edit_activo').checked = activo;
    
    // Configurar la acción del formulario
    document.getElementById('editarProductoForm').action = `/devops/productos/${id}/editar`;
    
    // Mostrar el modal
    const modal = new bootstrap.Modal(document.getElementById('editarProductoModal'));
                modal.show();
        }
    </script>
{% endblock %}