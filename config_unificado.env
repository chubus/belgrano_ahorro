# =================================================================
# CONFIGURACIÓN UNIFICADA - BELGRANO AHORRO
# =================================================================
# Archivo de configuración centralizado para todas las aplicaciones
# Copiar este archivo como .env y configurar los valores

# =================================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# =================================================================

# Entorno de ejecución
FLASK_ENV=development
FLASK_DEBUG=True

# Clave secreta para sesiones
SECRET_KEY=belgrano_ahorro_secret_key_2025

# Base de datos
DATABASE_PATH=belgrano_ahorro.db

# =================================================================
# CONFIGURACIÓN DE API - BELGRANO AHORRO
# =================================================================

# URL principal de Belgrano Ahorro
BELGRANO_AHORRO_URL=https://belgranoahorro-aliq.onrender.com

# Clave de API unificada para todas las comunicaciones
BELGRANO_AHORRO_API_KEY=belgrano_ahorro_api_key_2025

# Timeout para requests API (segundos)
API_TIMEOUT_SECS=30

# =================================================================
# CONFIGURACIÓN DE TICKETERA
# =================================================================

# URL de la ticketera
TICKETERA_URL=https://ticketerabelgrano.onrender.com

# Clave de API para comunicación con ticketera
TICKETERA_API_KEY=ticketera_api_key_2025

# =================================================================
# CONFIGURACIÓN DE DEVOPS
# =================================================================

# Credenciales de DevOps
DEVOPS_USERNAME=devops
DEVOPS_PASSWORD=devops_password

# URL de DevOps (si es diferente)
DEVOPS_URL=http://localhost:5002

# Configuración de sincronización
SYNC_ENABLED=True
SYNC_TIMEOUT=10

# =================================================================
# CONFIGURACIÓN DE RED
# =================================================================

# Puerto por defecto
PORT=5000

# Configuración de logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# =================================================================
# CONFIGURACIÓN DE PRODUCCIÓN
# =================================================================

# Para producción, estas URLs ya están configuradas correctamente:
# BELGRANO_AHORRO_URL=https://belgranoahorro-aliq.onrender.com
# TICKETERA_URL=https://ticketerabelgrano.onrender.com

# =================================================================
# NOTAS IMPORTANTES
# =================================================================

# 1. Todas las aplicaciones usan la misma API key: belgrano_ahorro_api_key_2025
# 2. La URL principal es: https://belgranoahorro-aliq.onrender.com
# 3. Para desarrollo local, cambiar URLs a localhost:5000, localhost:5001, etc.
# 4. Las credenciales DevOps son: devops / devops_password
